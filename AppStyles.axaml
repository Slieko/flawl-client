<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <Button Content="Test Button" />
        </Border>
    </Design.PreviewWith>

    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="12" />
    </Style>
</Styles>