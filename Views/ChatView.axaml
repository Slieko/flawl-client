<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FlawlClient.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:ChatViewModel"
             x:Class="FlawlClient.Views.ChatView">

    <Grid RowDefinitions="48,*,Auto">
        <StackPanel Margin="8,0,0,0" Orientation="Horizontal" Spacing="8">
            <Image VerticalAlignment="Center" Width="32" Height="32"
                   Source="{Binding ChatImage}">
                <Image.Clip>
                    <RectangleGeometry RadiusX="16" Rect="0,0,32,32" RadiusY="16" />
                </Image.Clip>
                <Interaction.Behaviors>
                    <ClickEventTrigger>
                        <InvokeCommandAction Command="{Binding ChangeAvatar}" PassEventArgsToCommand="True" />
                    </ClickEventTrigger>
                </Interaction.Behaviors>
            </Image>
            <SelectableTextBlock VerticalAlignment="Center" Text="{Binding ChatName}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentPresenter Margin="10" Content="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Interaction.Behaviors>
                <EventTriggerBehavior EventName="Loaded">
                    <InvokeCommandAction Command="{Binding ScrollToBottom}" PassEventArgsToCommand="True" />
                </EventTriggerBehavior>
            </Interaction.Behaviors>
        </ScrollViewer>

        <Label Grid.Row="2" Margin="10,5,0,0" Content="{Binding Exception}" />
        <TextBox Grid.Row="2" MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap" VerticalAlignment="Bottom"
                 Margin="5" PlaceholderText="Enter message..." Text="{Binding Message}">
            <Interaction.Behaviors>
                <KeyDownEventTrigger>
                    <InvokeCommandAction PassEventArgsToCommand="True" Command="{Binding KeyPressed}" />
                </KeyDownEventTrigger>
            </Interaction.Behaviors>
        </TextBox>
    </Grid>
</UserControl>