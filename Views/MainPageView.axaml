<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FlawlClient.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:MainPageViewModel"
             x:Class="FlawlClient.Views.MainPageView">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="100" MaxWidth="400" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListBox Grid.Column="0" Name="ChatList" ItemsSource="{Binding Chats}" Background="#101010">
            <Interaction.Behaviors>
                <EventTriggerBehavior EventName="SelectionChanged">
                    <InvokeCommandAction Command="{Binding DisplayChat}"
                                         CommandParameter="{Binding #ChatList.SelectedItem}" />
                </EventTriggerBehavior>
            </Interaction.Behaviors>
        </ListBox>
        <Button Grid.Column="0" Command="{Binding PerformLogout}" Content="Logout" />
        <GridSplitter Grid.Column="1" />

        <ContentControl Content="{Binding RightPanelContent}" Grid.Column="2" />


    </Grid>
</UserControl>